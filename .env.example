# Copy to .env and fill in. Never commit .env.

# Required. Sent as X-Operator-Key for allocations, approvals and Chaos Lab actions.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
OPERATOR_KEY=

# Database and Grafana admin passwords (defaults are fine locally; set real ones anywhere public)
POSTGRES_PASSWORD=fuelguard
GRAFANA_ADMIN_PASSWORD=admin

# Simulator (organizer image) settings
SIMULATION_SPEED=8            # ticks per second while RUNNING
TICK_MINUTES=15               # simulated minutes per tick
SIMULATOR_START_MODE=paused   # paused | running

# Backend
POLL_INTERVAL_SECONDS=1       # REST refresh interval; SSE triggers refreshes in between
LOG_LEVEL=INFO
DEPLOYMENT_VERSION=dev        # CI and deploy/update.sh set this to the git SHA

# Public deployment only (deploy/docker-compose.public.yml)
# PUBLIC_HOST=203.0.113.10.sslip.io

# Optional, used by the backend when running outside Docker
# SIMULATOR_URL=http://localhost:8000
# DATABASE_URL=postgresql://fuelguard:fuelguard@localhost:5432/fuelguard
# SIM_TIMEOUT_SECONDS=3
# SIM_RETRIES=2
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_WINDOW_SECONDS=10
# BREAKER_COOLDOWN_SECONDS=15

# Forecaster (Turjo's service)
# In compose: http://forecaster:8090; outside Docker: http://localhost:8090
FORECASTER_URL=http://localhost:8090
FORECASTER_MODEL=fc-v1

# Decision engine: auto (intelligence service when importable) | fixture (example data, UI work only) | off
RECOMMENDER=auto
# Autonomous mode may auto-execute decisions the gate clears (only after an operator re-arms Autonomous)
AUTOPILOT=true

# OpenAI API (for LangChain & LangGraph Copilot). Empty = template explanations only.
OPENAI_API_KEY=
COPILOT_MODEL=gpt-4o-mini
COPILOT_TIMEOUT_SECONDS=8

# LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=FuelGuard
