          },
          "expr": "sum by (component) (increase(fuelguard_fallback_activations_total[5m]))",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
